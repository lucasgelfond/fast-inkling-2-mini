#!/bin/zsh
# Launch the inkling_fast OpenAI/Anthropic-compatible server for Inkling 2 Mini.
# Usage: scripts/inkling-fast-serve <weights-dir> <port> [model-alias]
# Uses the ANE+GPU hybrid prefill for the 3-bit weights when coremltools is installed
# and the slices exist (runtime/ane/prod_int8); otherwise the GPU-only engine.
# Binds 127.0.0.1 only. Set PYTHON to override the interpreter (default .venv/bin/python).
set -euo pipefail
root=${0:A:h:h}
weights=${1:A}
port=$2
alias_name=${3:-Inkling-2-Mini}
cd "$root"
export PYTHONPATH="$root/src"
export INKLING_MODEL_ALIAS="$alias_name=$weights"
python=${PYTHON:-$root/.venv/bin/python}
ane_default=1
[[ "$weights" == */mlx-3bit ]] || ane_default=0
if [[ -d "$root/runtime/ane/prod_int8" && "${INKLING_ANE_PREFILL:-$ane_default}" == "1" ]] && "$python" -c "import coremltools" 2>/dev/null; then
  export INKLING_ANE_PREFILL=1
else
  unset INKLING_ANE_PREFILL
fi
exec "$python" "$root/scripts/inkling_serve.py" --model "$weights" --host 127.0.0.1 --port "$port" --max-num-seqs 1
