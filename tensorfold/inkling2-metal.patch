diff --git a/zig/src/families/inkling2/loop.zig b/zig/src/families/inkling2/loop.zig
new file mode 100644
index 0000000..af420fa
--- /dev/null
+++ b/zig/src/families/inkling2/loop.zig
@@ -0,0 +1,65 @@
+//! Inkling 2 Mini's loop (inkling2_loop): which layer each visit runs, in which pass, on which cache slot.
+const std = @import("std");
+
+/// loop_config: layers [start, end) run `passes` times; their message gates have rank `rank`.
+pub const Loop = struct { start: u32, end: u32, passes: u32, rank: u32 };
+
+/// One layer visit: the stored layer it runs, its pass (0 for every layer outside the core) and its cache slot.
+pub const Visit = struct { layer: u32, pass: u32, slot: u32 };
+
+/// Layer visits a token makes: every layer once, plus the core again for each extra pass.
+pub fn total(layers: u32, l: Loop) u32 {
+    return layers + (l.passes - 1) * (l.end - l.start);
+}
+
+/// The visits in order; pass p > 0 of core layer i uses slot `layers + (p - 1) * core + (i - start)`.
+pub fn plan(layers: u32, l: Loop, out: []Visit) error{LoopPlan}![]Visit {
+    if (l.start >= l.end or l.end > layers or l.passes == 0) return error.LoopPlan;
+    const n = total(layers, l);
+    if (out.len < n) return error.LoopPlan;
+    const core = l.end - l.start;
+    var at: usize = 0;
+    for (0..l.start) |i| {
+        out[at] = .{ .layer = @intCast(i), .pass = 0, .slot = @intCast(i) };
+        at += 1;
+    }
+    for (0..l.passes) |p| for (l.start..l.end) |i| {
+        const slot: u32 = if (p == 0) @intCast(i) else layers + @as(u32, @intCast(p - 1)) * core + @as(u32, @intCast(i)) - l.start;
+        out[at] = .{ .layer = @intCast(i), .pass = @intCast(p), .slot = slot };
+        at += 1;
+    };
+    for (l.end..layers) |i| {
+        out[at] = .{ .layer = @intCast(i), .pass = 0, .slot = @intCast(i) };
+        at += 1;
+    }
+    return out[0..n];
+}
+
+const t = std.testing;
+const mini: Loop = .{ .start = 6, .end = 18, .passes = 3, .rank = 64 };
+
+test "Mini makes 48 visits over 24 layers: 6, then 6-17 three times, then 18-23" {
+    var buf: [64]Visit = undefined;
+    const v = try plan(24, mini, &buf);
+    try t.expectEqual(@as(usize, 48), v.len);
+    try t.expectEqual(Visit{ .layer = 5, .pass = 0, .slot = 5 }, v[5]);
+    try t.expectEqual(Visit{ .layer = 6, .pass = 0, .slot = 6 }, v[6]);
+    try t.expectEqual(Visit{ .layer = 17, .pass = 0, .slot = 17 }, v[17]);
+    try t.expectEqual(Visit{ .layer = 6, .pass = 1, .slot = 24 }, v[18]);
+    try t.expectEqual(Visit{ .layer = 17, .pass = 2, .slot = 47 }, v[41]);
+    try t.expectEqual(Visit{ .layer = 18, .pass = 0, .slot = 18 }, v[42]);
+    try t.expectEqual(Visit{ .layer = 23, .pass = 0, .slot = 23 }, v[47]);
+    var seen: [48]bool = @splat(false);
+    for (v) |x| {
+        try t.expect(!seen[x.slot]);
+        seen[x.slot] = true;
+    }
+}
+
+test "a loop past the layers, empty or with no passes is refused" {
+    var buf: [64]Visit = undefined;
+    try t.expectError(error.LoopPlan, plan(24, .{ .start = 6, .end = 25, .passes = 3, .rank = 64 }, &buf));
+    try t.expectError(error.LoopPlan, plan(24, .{ .start = 6, .end = 6, .passes = 3, .rank = 64 }, &buf));
+    try t.expectError(error.LoopPlan, plan(24, .{ .start = 6, .end = 18, .passes = 0, .rank = 64 }, &buf));
+    try t.expectError(error.LoopPlan, plan(24, mini, buf[0..47]));
+}
