@@ -0,0 +1,142 @@
+//! The forward's dispatch helpers: one serial compute encoder, every family kernel and the core row projections.
+const std = @import("std");
+const mtl = @import("metal");
+const row = @import("../../../core/row_projection.zig");
+const g = @import("geometry.zig");
+const st = @import("state.zig");
+const wts = @import("weights.zig");
+const Model = @import("model.zig").Model;
+const Buffer = mtl.Buffer;
+
+/// A buffer at a byte offset.
+pub const Ref = struct { buf: Buffer, off: usize = 0 };
+
+pub fn at(buf: Buffer, off: usize) Ref {
+    return .{ .buf = buf, .off = off };
+}
+
+pub fn of(t: wts.Tensor) Ref {
+    return .{ .buf = t.buffer, .off = t.offset };
+}
+
+/// The attention-residual mix's constants (MixArgs in inkling2.metal).
+const MixArgs = extern struct { nb: u32, nq: u32, stride: u32, pstride: u32 };
+/// The experts' and head's constants (QmvArgs).
+pub const QmvArgs = extern struct { k: u32, n: u32, repeat: u32, indexed: u32 };
+
+pub const Enc = struct {
+    e: mtl.ComputeEncoder,
+    m: *const Model,
+    s: *st.Scratch,
+    rows: usize,
+
+    pub fn pipe(x: Enc, comptime key: []const u8) void {
+        x.e.setPipeline(x.m.kernels.get(key));
+    }
+    pub fn bind(x: Enc, r: Ref, slot: usize) void {
+        x.e.setBuffer(r.buf, r.off, slot);
+    }
+    pub fn value(x: Enc, v: anytype, slot: usize) void {
+        x.e.setValue(v, slot);
+    }
+    pub fn groups(x: Enc, grid: [3]usize, group: [3]usize) void {
+        x.e.dispatchGroups(mtl.Size.of(grid[0], grid[1], grid[2]), mtl.Size.of(group[0], group[1], group[2]));
+    }
+    pub fn threads(x: Enc, grid: [3]usize, group: [3]usize) void {
+        x.e.dispatchThreads(mtl.Size.of(grid[0], grid[1], grid[2]), mtl.Size.of(group[0], group[1], group[2]));
+    }
+
+    /// y[rows] = x[rows] W^T for a bf16-table affine projection: the core row kernels (MLX's arithmetic).
+    pub fn project(x: Enc, w: wts.Linear, in: Ref, out: Ref, rows: usize) void {
+        const call = row.call(&x.m.kernels.rows, w, rows, false) catch unreachable;
+        x.e.setPipeline(call.pipeline);
+        x.bind(in, 0);
+        x.e.setBuffer(w.w, w.w_off, 1);
+        x.e.setBuffer(w.scales, w.s_off, 2);
+        x.e.setBuffer(w.biases, w.b_off, 3);
+        x.e.setValue(call.dims, 4);
+        x.bind(out, 5);
+        x.groups(.{ call.groups, 1, 1 }, .{ call.threads, 1, 1 });
+    }
+
+    /// out (bf16 [rows][hidden]) = RMS norm of `in` rows `stride` apart (FP32 or bf16) with gain `w`.
+    pub fn rms(x: Enc, f32_in: bool, in: Ref, stride: usize, w: wts.Tensor, out: Ref, rows: usize) void {
+        if (f32_in) x.pipe("ink_rms_f32") else x.pipe("ink_rms_bf16");
+        x.bind(in, 0);
+        x.bind(of(w), 1);
+        x.value(@as(u32, @intCast(stride)), 2);
+        x.value(x.m.config.text.eps, 3);
+        x.bind(out, 4);
+        x.groups(.{ rows, 1, 1 }, .{ 256, 1, 1 });
+    }
+
+    /// y = x W^T for a bf16 matrix [n, k] (nn.Linear), bf16 or FP32 outputs.
+    pub fn dense(x: Enc, f32_out: bool, w: wts.Tensor, in: Ref, out: Ref, rows: usize) void {
+        if (f32_out) x.pipe("ink_dense_bf16_f32") else x.pipe("ink_dense_bf16_bf16");
+        const n = w.shape[0];
+        x.bind(in, 0);
+        x.bind(of(w), 1);
+        x.value([2]u32{ @intCast(w.shape[1]), @intCast(n) }, 2);
+        x.bind(out, 3);
+        x.groups(.{ (n + 3) / 4, rows, 1 }, .{ 128, 1, 1 });
+    }
+
+    /// out[row][q] = the softmax mix over `nb` blocks of `blocks` (rows apart by the scratch) and the partial rows.
+    pub fn mix(x: Enc, blocks: Ref, nb: usize, f32_partial: bool, partial: Ref, pstride: usize, query: Ref, nq: usize, out: Ref) void {
+        if (f32_partial) x.pipe("ink_mix_f32") else x.pipe("ink_mix_bf16");
+        x.bind(blocks, 0);
+        x.bind(partial, 1);
+        x.bind(query, 2);
+        x.e.setBytes(std.mem.asBytes(&MixArgs{ .nb = @intCast(nb), .nq = @intCast(nq), .stride = @intCast(x.s.rows * g.hidden), .pstride = @intCast(pstride) }), 3);
+        x.bind(out, 4);
+        x.groups(.{ x.rows, 1, 1 }, .{ 256, 1, 1 });
+    }
+
+    /// dst = src over `n` bf16 values.
+    pub fn copy(x: Enc, src: Ref, dst: Ref, n: usize) void {
+        x.pipe("ink_copy");
+        x.bind(src, 0);
+        x.bind(dst, 1);
+        x.value(@as(u32, @intCast(n)), 2);
+        x.threads(.{ n, 1, 1 }, .{ 256, 1, 1 });
+    }
+
+    /// The message gate `gt` on h (FP32 rows `hs` apart) and message m (rows `ms` apart) into scratch gate_out.
+    pub fn gate(x: Enc, gt: wts.Gate, h: Ref, hs: usize, m: Ref, ms: usize) void {
+        const s = x.s;
+        x.pipe("ink_gate_in");
+        x.bind(h, 0);
+        x.bind(m, 1);
+        x.value([2]u32{ @intCast(hs), @intCast(ms) }, 2);
+        x.value(x.m.config.text.eps, 3);
+        x.bind(at(s.gate_in, 0), 4);
+        x.groups(.{ x.rows, 1, 1 }, .{ 256, 1, 1 });
+        x.dense(false, gt.down, at(s.gate_in, 0), at(s.gate_low, 0), x.rows);
+        x.pipe("ink_gate_out");
+        x.bind(at(s.gate_low, 0), 0);
+        x.bind(of(gt.forget), 1);
+        x.bind(of(gt.gain), 2);
+        x.bind(h, 3);
+        x.bind(m, 4);
+        x.value([2]u32{ @intCast(hs), @intCast(ms) }, 5);
+        x.bind(at(s.gate_out, 0), 6);
+        x.threads(.{ g.hidden, x.rows, 1 }, .{ 256, 1, 1 });
+    }
+
+    /// Experts' gate-up SwiGLU (`glu`, with `up`) or down over every pick: y[slot] FP32.
+    pub fn experts(x: Enc, glu: bool, w: wts.Experts, up: ?wts.Experts, in: Ref, out: Ref, slots: usize) void {
+        x.e.setPipeline(x.m.kernels.experts(glu, w.bits, w.bf16));
+        x.bind(in, 0);
+        x.bind(of(w.w), 1);
+        x.bind(of(w.s), 2);
+        x.bind(of(w.b), 3);
+        x.e.setBytes(std.mem.asBytes(&QmvArgs{ .k = @intCast(w.k), .n = @intCast(w.n), .repeat = if (glu) g.topk else 1, .indexed = 1 }), 4);
+        x.bind(out, 5);
+        x.bind(at(x.s.picks, 0), 6);
+        const u = up orelse w;
+        x.bind(of(u.w), 7);
+        x.bind(of(u.s), 8);
+        x.bind(of(u.b), 9);
+        x.groups(.{ w.n / 8, slots, 1 }, .{ 64, 1, 1 });
+    }
+};
diff --git a/zig/src/families/inkling2/metal/forward.zig b/zig/src/families/inkling2/metal/forward.zig
new file mode 100644
index 0000000..6ca7341
--- /dev/null
+++ b/zig/src/families/inkling2/metal/forward.zig
@@ -0,0 +1,108 @@
+//! One command buffer a call: the embedding, 48 layer visits over one stream's slots, the final mix, norm and head.
+const std = @import("std");
+const mtl = @import("metal");
+const g = @import("geometry.zig");
+const st = @import("state.zig");
+const layer = @import("layer.zig");
+const enc = @import("encode.zig");
+const Model = @import("model.zig").Model;
+const at = enc.at;
+const of = enc.of;
+
+/// `last`: the last row's logits; `all`: every row's logits and greedy pick (scratch best); `none`: no head.
+pub const Head = enum { last, all, none };
+
+pub const Options = struct {
+    head: Head = .last,
+    /// Each visit's input rows, [visits][rows][hidden] bf16, and the final normed rows after them (validation).
+    capture: ?mtl.Buffer = null,
+    /// Visits to run (debugging: the scratch then holds the last one's rows); the head runs after all 48 only.
+    visits: usize = g.visits,
+};
+
+/// GPU seconds of every call so far.
+pub var gpu_seconds: f64 = 0;
+
+/// `ids` at positions cache.len.. through the model; the cache's slots take their keys, values and conv states.
+pub fn run(m: *const Model, s: *st.Scratch, cache: *st.Cache, ids: []const u32, o: Options) !void {
+    const rows = ids.len;
+    if (rows == 0 or rows > s.rows or (o.head == .all and rows > s.logit_rows)) return error.InklingRowsExceeded;
+    if (cache.len + rows > cache.capacity) return error.InklingContextFull;
+    for (ids) |id| if (id >= g.vocab) return error.InvalidInklingToken;
+    @memcpy(s.ids.slice(u32, rows), ids);
+    const pool = mtl.objc.Pool.push();
+    defer pool.pop();
+    const cb = m.queue.commandBuffer();
+    const e = cb.compute(.serial);
+    const x = enc.Enc{ .e = e, .m = m, .s = s, .rows = rows };
+    encode(x, cache, o);
+    e.end();
+    cb.commit();
+    cb.wait();
+    gpu_seconds += cb.gpuSeconds();
+    if (cb.failure()) |msg| {
+        std.debug.print("Inkling 2 forward: {s}\n", .{msg});
+        return error.GpuFailed;
+    }
+    cache.len += rows;
+    if (o.head != .none and o.visits == g.visits) {
+        const row = if (o.head == .all) rows - 1 else 0;
+        @memcpy(cache.logits.contents()[0 .. g.vocab * 4], (s.logits.contents() + row * g.vocab * 4)[0 .. g.vocab * 4]);
+    }
+}
+
+fn encode(x: enc.Enc, cache: *const st.Cache, o: Options) void {
+    const m = x.m;
+    const s = x.s;
+    const d = g.hidden;
+    const rows = x.rows;
+    const w = &m.weights;
+    const plane = s.rows * d * 2;
+    x.pipe("ink_embed_norm");
+    x.bind(at(s.ids, 0), 0);
+    x.e.setBuffer(w.embed.w, w.embed.w_off, 1);
+    x.e.setBuffer(w.embed.scales, w.embed.s_off, 2);
+    x.e.setBuffer(w.embed.biases, w.embed.b_off, 3);
+    x.bind(of(w.embed_norm), 4);
+    x.value(m.config.text.eps, 5);
+    x.bind(at(s.x, 0), 6);
+    x.groups(.{ rows, 1, 1 }, .{ 256, 1, 1 });
+    const loop = m.config.loop.?;
+    var blocks: usize = 0;
+    for (m.plan[0..o.visits], 0..) |v, i| {
+        if (v.layer == loop.start and v.pass > 0) {
+            // Restart from the pre-loop state; the messages read the last pass's layer-12 block and its output.
+            x.copy(at(s.blocks, 2 * plane), at(s.states, 0), rows * d);
+            x.copy(at(s.x, 0), at(s.states, plane), rows * d);
+            x.copy(at(s.blocks, plane), at(s.x, 0), rows * d);
+            blocks = 1;
+        }
+        if (o.capture) |cap| x.copy(at(s.x, 0), at(cap, i * rows * d * 2), rows * d);
+        blocks = layer.run(x, &w.layers[v.layer], .{ .index = i, .layer = v.layer, .pass = v.pass, .slot = v.slot, .blocks = blocks }, cache);
+    }
+    if (o.visits < g.visits) return;
+    x.mix(at(s.blocks, 0), blocks, false, at(s.x, 0), d, of(w.final_query), 1, at(s.mix, 0));
+    x.rms(true, at(s.mix, 0), d, w.norm, at(s.xm, 0), rows);
+    if (o.capture) |cap| x.copy(at(s.xm, 0), at(cap, g.visits * rows * d * 2), rows * d);
+    if (o.head == .none) return;
+    const head_rows: usize = if (o.head == .all) rows else 1;
+    const first: usize = if (o.head == .all) 0 else rows - 1;
+    x.e.setPipeline(m.kernels.head(w.head.bits));
+    x.bind(at(s.xm, first * d * 2), 0);
+    x.e.setBuffer(w.head.w, w.head.w_off, 1);
+    x.e.setBuffer(w.head.scales, w.head.s_off, 2);
+    x.e.setBuffer(w.head.biases, w.head.b_off, 3);
+    x.e.setBytes(std.mem.asBytes(&enc.QmvArgs{ .k = d, .n = g.vocab, .repeat = 1, .indexed = 0 }), 4);
+    x.bind(at(s.logits, 0), 5);
+    x.bind(at(s.ids, 0), 6);
+    x.e.setBuffer(w.head.w, w.head.w_off, 7);
+    x.e.setBuffer(w.head.scales, w.head.s_off, 8);
+    x.e.setBuffer(w.head.biases, w.head.b_off, 9);
+    x.groups(.{ g.vocab / 8, head_rows, 1 }, .{ 64, 1, 1 });
+    x.pipe("ink_head_pick");
+    x.bind(at(s.logits, 0), 0);
+    x.value([3]u32{ g.vocab, m.config.text.unpadded_vocab, 0 }, 1);
+    x.value(m.config.text.logit_cap, 2);
+    x.bind(at(s.best, 0), 3);
+    x.groups(.{ head_rows, 1, 1 }, .{ 1024, 1, 1 });
+}
diff --git a/zig/src/families/inkling2/metal/geometry.zig b/zig/src/families/inkling2/metal/geometry.zig
new file mode 100644
index 0000000..8e50ce5
--- /dev/null
+++ b/zig/src/families/inkling2/metal/geometry.zig
@@ -0,0 +1,46 @@
+//! Inkling 2 Mini's pinned geometry on Metal (the kernels' constants); the loader refuses a config that differs.
+const std = @import("std");
+const config = @import("../config.zig");
+
+pub const hidden = 2304;
+pub const q_heads = 24;
+pub const kv_heads = 8;
+pub const head_dim = 128;
+pub const d_rel = 16;
+/// The sliding window and both kinds' relative-bias extent.
+pub const extent = 1024;
+pub const experts = 128;
+pub const topk = 8;
+pub const inter = 1152;
+pub const vocab = 201024;
+pub const layers = 24;
+pub const visits = 48;
+pub const block = 6;
+pub const rank = 64;
+pub const group = 64;
+/// Each visit's conv states: k and v (kv width), after attention and after the MLP (hidden), three rows each, FP32.
+pub const conv_floats = 3 * (2 * kv_heads * head_dim + 2 * hidden);
+
+pub const Error = error{UnsupportedInklingGeometry};
+
+/// The config's shape is the one the kernels are written for: Inkling 2 Mini, text only.
+pub fn check(c: *const config.Config) Error!void {
+    const t = &c.text;
+    const l = c.loop orelse return error.UnsupportedInklingGeometry;
+    const same = t.hidden == hidden and t.layers == layers and t.vocab == vocab and t.global.q == q_heads and
+        t.global.kv == kv_heads and t.global.dim == head_dim and t.local.q == q_heads and t.local.kv == kv_heads and
+        t.local.dim == head_dim and t.d_rel == d_rel and t.window == extent and t.rel_extent == extent and
+        t.experts == experts and t.topk == topk and t.expert_inter == inter and t.block == block and
+        l.start == 6 and l.end == 18 and l.passes == 3 and l.rank == rank and c.format == .mlx_affine;
+    if (!same) return error.UnsupportedInklingGeometry;
+}
+
+test "Mini's MLX config is the pinned geometry; Small is not" {
+    const t = std.testing;
+    var why: config.Why = .{};
+    const mini = try config.parse(t.allocator, @embedFile("../fixtures/mini_mlx_config.json"), &why);
+    try check(&mini);
+    try t.expectEqual(@as(u32, visits), mini.visits());
+    const small = try config.parse(t.allocator, @embedFile("../fixtures/config.json"), &why);
+    try t.expectError(error.UnsupportedInklingGeometry, check(&small));
+}
diff --git a/zig/src/families/inkling2/metal/kernels.zig b/zig/src/families/inkling2/metal/kernels.zig
new file mode 100644
index 0000000..83ad773
--- /dev/null
+++ b/zig/src/families/inkling2/metal/kernels.zig
@@ -0,0 +1,87 @@
+//! Inkling 2 Mini's Metal pipelines: the family's kernels (inkling2*.metal) and the core row projections.
+const std = @import("std");
+const mtl = @import("metal");
+const sources = @import("kernel_sources");
+const row = @import("../../../core/row_projection.zig");
+
+const names = [_][:0]const u8{
+    "ink_embed_norm",
+    "ink_rms_f32",
+    "ink_rms_bf16",
+    "ink_mix_bf16",
+    "ink_mix_f32",
+    "ink_gate_in",
+    "ink_gate_out",
+    "ink_dense_bf16_bf16",
+    "ink_dense_bf16_f32",
+    "ink_conv_kv",
+    "ink_conv_attn",
+    "ink_conv_mlp",
+    "ink_conv_mlp_bf16",
+    "ink_conv_dyn",
+    "ink_route",
+    "ink_combine",
+    "ink_copy",
+    "ink_head_pick",
+    "ink_prep",
+    "ink_attn",
+    "ink_glu_q3",
+    "ink_glu_q4",
+    "ink_down_q3",
+    "ink_down_q4",
+    "ink_head_q4",
+    "ink_head_q6",
+    "ink_head_q8",
+    "ink_glu_q3_bf16",
+    "ink_glu_q4_bf16",
+    "ink_down_q3_bf16",
+    "ink_down_q4_bf16",
+};
+
+pub const Kernels = struct {
+    pipelines: [names.len]mtl.Pipeline,
+    rows: row.Pipelines,
+
+    pub fn get(self: *const Kernels, comptime key: []const u8) mtl.Pipeline {
+        inline for (names, 0..) |n, i| if (comptime std.mem.eql(u8, n, key)) return self.pipelines[i];
+        @compileError("no Inkling 2 kernel " ++ key);
+    }
+
+    /// The experts' gate-up SwiGLU or down kernel at a width of 3 or 4 bits, for FP32 or bf16 tables.
+    pub fn experts(self: *const Kernels, glu: bool, bits: u8, bf16: bool) mtl.Pipeline {
+        if (bf16) {
+            if (glu) return if (bits == 3) self.get("ink_glu_q3_bf16") else self.get("ink_glu_q4_bf16");
+            return if (bits == 3) self.get("ink_down_q3_bf16") else self.get("ink_down_q4_bf16");
+        }
+        if (glu) return if (bits == 3) self.get("ink_glu_q3") else self.get("ink_glu_q4");
+        return if (bits == 3) self.get("ink_down_q3") else self.get("ink_down_q4");
+    }
+
+    /// The head's FP32-logit kernel at its width (4, 6 or 8 bits).
+    pub fn head(self: *const Kernels, bits: u8) mtl.Pipeline {
+        return switch (bits) {
+            4 => self.get("ink_head_q4"),
+            6 => self.get("ink_head_q6"),
+            else => self.get("ink_head_q8"),
+        };
+    }
+
+    pub fn deinit(self: *Kernels) void {
+        for (self.pipelines) |p| p.deinit();
+        self.rows.deinit();
+    }
+};
+
+pub fn load(device: mtl.Device) !Kernels {
+    var out: Kernels = undefined;
+    const lib = try mtl.Library.fromSource(device, sources.inkling2, mtl.CompileOptions.mlx());
+    defer lib.deinit();
+    var loaded: usize = 0;
+    errdefer for (out.pipelines[0..loaded]) |p| p.deinit();
+    for (names, 0..) |name, i| {
+        out.pipelines[i] = try mtl.Pipeline.init(device, lib, name, false);
+        loaded += 1;
+    }
+    out.rows = try row.Pipelines.load(device);
+    return out;
+}
diff --git a/zig/src/families/inkling2/metal/layer.zig b/zig/src/families/inkling2/metal/layer.zig
new file mode 100644
index 0000000..4a98835
--- /dev/null
+++ b/zig/src/families/inkling2/metal/layer.zig
@@ -0,0 +1,176 @@
+//! One layer visit: the attention input mix (and pass 2-3 message gates), attention, its conv, the MLP input, experts.
+const std = @import("std");
+const g = @import("geometry.zig");
+const st = @import("state.zig");
+const wts = @import("weights.zig");
+const enc = @import("encode.zig");
+const Enc = enc.Enc;
+const Ref = enc.Ref;
+const at = enc.at;
+const of = enc.of;
+
+/// The prepared rows' constants (PrepArgs in inkling2_attn.metal) and the attention's (AttnArgs).
+const PrepArgs = extern struct { pos0: u32, global: u32, qk_clip: f32, rel_clip: f32, eps: f32, log_floor: f32, log_alpha: f32, pad: u32 = 0 };
+const AttnArgs = extern struct { pos0: u32, sliding: u32, scale: f32, pad: u32 = 0 };
+
+/// Where a visit runs: its layer's weights, its loop pass, its cache slot, and how many blocks are finished.
+pub const Visit = struct { index: usize, layer: usize, pass: usize, slot: usize, blocks: usize };
+
+/// The visit's q, k and v input rows: mix parts, gated in passes 2 and 3, each RMS normed into xq, xk, xv.
+fn inputs(x: Enc, w: *const wts.Layer, v: Visit) void {
+    const s = x.s;
+    const d = g.hidden;
+    const rows = x.rows;
+    const nq: usize = if (w.attn_query == null) 0 else if (w.global) 3 else 1;
+    if (nq > 0) x.mix(at(s.blocks, 0), v.blocks, false, at(s.x, 0), d, of(w.attn_query.?), nq, at(s.mix, 0));
+    const looped = v.pass > 0;
+    if (looped) {
+        const query = at(x.m.weights.message_query.buffer, x.m.weights.message_query.offset + (v.layer - 6) * 4 * d * 4);
+        x.mix(at(s.states, 0), 1, false, at(s.states, s.rows * d * 2), d, query, 4, at(s.msg, 0));
+    }
+    const outs = [3]Ref{ at(s.xq, 0), at(s.xk, 0), at(s.xv, 0) };
+    // A sliding layer outside the loop normalizes one input for all three projections.
+    const parts: usize = if (!w.global and !looped) 1 else 3;
+    for (0..parts) |j| {
+        if (nq == 0) {
+            x.rms(false, at(s.x, 0), d, w.norms[j], outs[j], rows);
+            continue;
+        }
+        const src = at(s.mix, @min(j, nq - 1) * d * 4);
+        if (looped) {
+            x.gate(w.gates.?[j], src, nq * d, at(s.msg, j * d * 4), 4 * d);
+            x.rms(true, at(s.gate_out, 0), d, w.norms[j], outs[j], rows);
+        } else x.rms(true, src, nq * d, w.norms[j], outs[j], rows);
+    }
+}
+
+fn kvConv(x: Enc, c: wts.KvConv, in: Ref, xin: Ref, dyn: Ref, state: Ref, out: Ref) void {
+    const kv = g.kv_heads * g.head_dim;
+    switch (c) {
+        .static => |weight| {
+            x.pipe("ink_conv_kv");
+            x.bind(in, 0);
+            x.bind(state, 1);
+            x.bind(of(weight), 2);
+            x.value([4]u32{ kv, @intCast(x.rows), 0, 0 }, 3);
+            x.bind(out, 4);
+            x.bind(in, 5);
+            x.bind(in, 6);
+            x.threads(.{ kv, 1, 1 }, .{ 256, 1, 1 });
+        },
+        .dynamic => |d| {
+            x.dense(false, d.proj, xin, dyn, x.rows);
+            x.pipe("ink_conv_dyn");
+            x.bind(in, 0);
+            x.bind(state, 1);
+            x.bind(of(d.taps), 2);
+            x.bind(dyn, 3);
+            x.value(@as(u32, @intCast(x.rows)), 4);
+            x.bind(out, 5);
+            x.threads(.{ kv, 1, 1 }, .{ 256, 1, 1 });
+        },
+    }
+}
+
+fn attention(x: Enc, w: *const wts.Layer, v: Visit, cache: *const st.Cache) void {
+    const s = x.s;
+    const t = &x.m.config.text;
+    const rows = x.rows;
+    const conv = st.Cache.convOffset(v.slot);
+    const kv = g.kv_heads * g.head_dim;
+    x.project(w.q, at(s.xq, 0), at(s.q, 0), rows);
+    x.project(w.r, at(s.xq, 0), at(s.r, 0), rows);
+    x.project(w.gate, at(s.xq, 0), at(s.gate, 0), rows);
+    x.dense(false, w.sink, at(s.xq, 0), at(s.sink, 0), rows);
+    // A sliding layer outside the loop feeds one normed input to all three projections.
+    const shared = !w.global and v.pass == 0;
+    const xk = if (shared) at(s.xq, 0) else at(s.xk, 0);
+    const xv = if (shared) at(s.xq, 0) else at(s.xv, 0);
+    x.project(w.k, xk, at(s.k, 0), rows);
+    x.project(w.v, xv, at(s.v, 0), rows);
+    kvConv(x, w.k_conv, at(s.k, 0), xk, at(s.dk, 0), at(cache.conv, conv), at(s.kc, 0));
+    kvConv(x, w.v_conv, at(s.v, 0), xv, at(s.dv, 0), at(cache.conv, conv + 3 * kv * 4), at(s.vc, 0));
+    const pos0: u32 = @intCast(cache.len);
+    x.pipe("ink_prep");
+    for ([_]Ref{ at(s.q, 0), at(s.r, 0), at(s.kc, 0), at(s.vc, 0), of(w.q_scale), of(w.rel_scale) }, 0..) |r, i| x.bind(r, i);
+    const prep = PrepArgs{ .pos0 = pos0, .global = @intFromBool(w.global), .qk_clip = t.qk_clip, .rel_clip = t.rel_clip, .eps = t.eps, .log_floor = @floatFromInt(t.log_floor), .log_alpha = t.log_alpha };
+    x.e.setBytes(std.mem.asBytes(&prep), 6);
+    x.bind(at(s.qp, 0), 7);
+    x.bind(at(s.rp, 0), 8);
+    x.bind(at(cache.kv, cache.keysOffset(v.slot)), 9);
+    x.bind(at(cache.kv, cache.valuesOffset(v.slot)), 10);
+    x.groups(.{ 2 * g.q_heads + 2 * g.kv_heads, rows, 1 }, .{ 32, 1, 1 });
+    x.pipe("ink_attn");
+    for ([_]Ref{ at(s.qp, 0), at(s.rp, 0), at(s.sink, 0), at(s.gate, 0), at(cache.kv, cache.keysOffset(v.slot)), at(cache.kv, cache.valuesOffset(v.slot)), of(w.rel_proj) }, 0..) |r, i| x.bind(r, i);
+    const args = AttnArgs{ .pos0 = pos0, .sliding = @intFromBool(!w.global), .scale = 1.0 / @sqrt(@as(f32, g.head_dim)) };
+    x.e.setBytes(std.mem.asBytes(&args), 7);
+    x.bind(at(s.attn, 0), 8);
+    x.groups(.{ g.q_heads, rows, 1 }, .{ 256, 1, 1 });
+    x.project(w.o, at(s.attn, 0), at(s.o, 0), rows);
+}
+
+/// The visit, x in place: a boundary layer's input joins the finished blocks after attention. Returns the block count.
+pub fn run(x: Enc, w: *const wts.Layer, v: Visit, cache: *const st.Cache) usize {
+    const s = x.s;
+    const d = g.hidden;
+    const rows = x.rows;
+    const conv = st.Cache.convOffset(v.slot);
+    const kv = g.kv_heads * g.head_dim;
+    inputs(x, w, v);
+    attention(x, w, v, cache);
+    x.pipe("ink_conv_attn");
+    x.bind(at(s.o, 0), 0);
+    x.bind(at(cache.conv, conv + 6 * kv * 4), 1);
+    x.bind(of(w.attn_conv), 2);
+    x.value([4]u32{ d, @intCast(rows), @intFromBool(!w.boundary), 0 }, 3);
+    x.bind(at(s.res, 0), 4);
+    x.bind(at(s.x, 0), 5);
+    x.bind(at(s.res, 0), 6);
+    x.threads(.{ d, 1, 1 }, .{ 256, 1, 1 });
+    var blocks = v.blocks;
+    if (w.boundary) {
+        x.copy(at(s.x, 0), at(s.blocks, blocks * s.rows * d * 2), rows * d);
+        blocks += 1;
+    }
+    x.mix(at(s.blocks, 0), blocks, true, at(s.res, 0), d, of(w.mlp_query), 1, at(s.mix, 0));
+    var hidden = at(s.mix, 0);
+    if (v.pass > 0) {
+        x.gate(w.gates.?[3], hidden, d, at(s.msg, 3 * d * 4), 4 * d);
+        hidden = at(s.gate_out, 0);
+    }
+    x.rms(true, hidden, d, w.post_norm, at(s.xm, 0), rows);
+    moe(x, w);
+    if (w.ex_down.bf16) x.pipe("ink_conv_mlp_bf16") else x.pipe("ink_conv_mlp");
+    x.bind(at(s.moe, 0), 0);
+    x.bind(at(cache.conv, conv + (6 * kv + 3 * d) * 4), 1);
+    x.bind(of(w.mlp_conv), 2);
+    x.value([4]u32{ d, @intCast(rows), 0, 0 }, 3);
+    x.bind(at(s.x, 0), 4);
+    x.bind(at(s.x, 0), 5);
+    x.bind(at(s.res, 0), 6);
+    x.threads(.{ d, 1, 1 }, .{ 256, 1, 1 });
+    return blocks;
+}
+
+/// Router, top-8 picks, the experts' SwiGLU and down projections (FP32), and their weighted sum into scratch moe.
+fn moe(x: Enc, w: *const wts.Layer) void {
+    const s = x.s;
+    const rows = x.rows;
+    const slots = rows * g.topk;
+    x.dense(true, w.router, at(s.xm, 0), at(s.route, 0), rows);
+    x.pipe("ink_route");
+    x.bind(at(s.route, 0), 0);
+    x.bind(of(w.router_bias), 1);
+    x.value(x.m.config.text.route_scale, 2);
+    x.bind(at(s.picks, 0), 3);
+    x.bind(at(s.weights, 0), 4);
+    x.groups(.{ rows, 1, 1 }, .{ g.experts, 1, 1 });
+    x.experts(true, w.ex_gate, w.ex_up, at(s.xm, 0), at(s.act, 0), slots);
+    x.experts(false, w.ex_down, null, at(s.act, 0), at(s.ey, 0), slots);
+    x.pipe("ink_combine");
+    x.bind(at(s.ey, 0), 0);
+    x.bind(at(s.weights, 0), 1);
+    x.bind(at(s.moe, 0), 2);
+    x.value(@as(u32, @intFromBool(w.ex_down.bf16)), 3);
+    x.threads(.{ g.hidden, rows, 1 }, .{ 256, 1, 1 });
+}
