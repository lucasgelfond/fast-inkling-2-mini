diff --git a/zig/src/families/inkling2/metal/model.zig b/zig/src/families/inkling2/metal/model.zig
new file mode 100644
index 0000000..5fb07a3
--- /dev/null
+++ b/zig/src/families/inkling2/metal/model.zig
@@ -0,0 +1,77 @@
+//! A native Inkling 2 Mini model on Metal: the validated config, the checkpoint's views and the pipelines.
+const std = @import("std");
+const mtl = @import("metal");
+const config = @import("../config.zig");
+const loop = @import("../loop.zig");
+const ckpt = @import("../../../core/checkpoint_metal.zig");
+const shards = @import("../../../core/checkpoint.zig");
+const g = @import("geometry.zig");
+const weights = @import("weights.zig");
+const kernels = @import("kernels.zig");
+
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    device: mtl.Device,
+    queue: mtl.Queue,
+    config: config.Config,
+    /// Every visit in schedule order (layer, pass, cache slot).
+    plan: [g.visits]loop.Visit,
+    checkpoint: ckpt.Checkpoint,
+    weights: weights.Weights,
+    kernels: kernels.Kernels,
+    resident: ?mtl.ResidencySet = null,
+
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !*Model {
+        var path_buf: [std.fs.max_path_bytes]u8 = undefined;
+        const path = try std.fmt.bufPrint(&path_buf, "{s}/config.json", .{dir});
+        const json = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+        defer gpa.free(json);
+        var why: config.Why = .{};
+        const c = config.parse(gpa, json, &why) catch |e| {
+            std.log.err("Inkling 2: {s}", .{why.text()});
+            return e;
+        };
+        g.check(&c) catch |e| {
+            std.log.err("Inkling 2 on Metal serves Inkling 2 Mini's MLX affine checkpoint only (hidden 2304, a 6-17 loop)", .{});
+            return e;
+        };
+        const m = try gpa.create(Model);
+        errdefer gpa.destroy(m);
+        m.gpa = gpa;
+        m.config = c;
+        _ = try loop.plan(g.layers, c.loop.?, &m.plan);
+        m.device = try mtl.Device.init();
+        errdefer m.device.deinit();
+        m.queue = try m.device.queue();
+        errdefer m.queue.deinit();
+        m.checkpoint = ckpt.Checkpoint.init(gpa);
+        errdefer m.checkpoint.deinit();
+        const files = try shards.shardFiles(gpa, io, dir);
+        defer shards.freeShardFiles(gpa, files);
+        for (files) |file| try m.checkpoint.addFile(m.device, file, "");
+        m.weights = try weights.load(&m.checkpoint);
+        m.kernels = try kernels.load(m.device);
+        errdefer m.kernels.deinit();
+        m.resident = null;
+        if (m.device.residencySet(m.checkpoint.shards.items.len)) |set| {
+            for (m.checkpoint.shards.items) |shard| set.add(shard.buffer);
+            set.commit();
+            set.requestResidency();
+            m.queue.addResidencySet(set);
+            m.resident = set;
+        } else |_| {}
+        return m;
+    }
+
+    pub fn deinit(m: *Model) void {
+        if (m.resident) |set| {
+            m.queue.removeResidencySet(set);
+            set.deinit();
+        }
+        m.kernels.deinit();
+        m.checkpoint.deinit();
+        m.queue.deinit();
+        m.device.deinit();
+        m.gpa.destroy(m);
+    }
+};
diff --git a/zig/src/families/inkling2/metal/state.zig b/zig/src/families/inkling2/metal/state.zig
new file mode 100644
index 0000000..f106642
--- /dev/null
+++ b/zig/src/families/inkling2/metal/state.zig
@@ -0,0 +1,190 @@
+//! A stream's 48 visit slots (keys, values and four conv states each) and a forward's scratch rows.
+const std = @import("std");
+const mtl = @import("metal");
+const g = @import("geometry.zig");
+
+const opts = mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked;
+
+/// Owned Metal buffers, joined to a residency set when one is followed.
+pub const Storage = struct {
+    residency: ?mtl.ResidencySet.Follow = null,
+    gpa: std.mem.Allocator,
+    device: mtl.Device,
+    buffers: std.ArrayList(mtl.Buffer) = .empty,
+
+    pub fn alloc(self: *Storage, bytes: usize) !mtl.Buffer {
+        const b = try self.device.buffer(@max(bytes, 16), opts);
+        errdefer b.deinit();
+        try self.buffers.append(self.gpa, b);
+        if (self.residency) |f| f.join(f.ctx, b);
+        return b;
+    }
+
+    pub fn setResident(self: *Storage, hook: ?mtl.ResidencySet.Follow) void {
+        for (self.buffers.items) |b| {
+            if (self.residency) |f| f.leave(f.ctx, b);
+            if (hook) |f| f.join(f.ctx, b);
+        }
+        self.residency = hook;
+    }
+
+    pub fn deinit(self: *Storage) void {
+        self.setResident(null);
+        for (self.buffers.items) |b| b.deinit();
+        self.buffers.deinit(self.gpa);
+    }
+};
+
+/// Bytes of one position's keys (or values) in one slot: 8 heads of 128, bf16.
+pub const row_kv_bytes = g.kv_heads * g.head_dim * 2;
+
+/// Each visit slot's keys and values, `capacity` positions (every position kept), and its conv states.
+pub const Cache = struct {
+    memory: Storage,
+    capacity: usize,
+    len: usize = 0,
+    /// [slot][keys, values][capacity][8][128] bf16.
+    kv: mtl.Buffer,
+    /// [slot][conv_floats] FP32: k, v (3 rows of 1024), after attention, after the MLP (3 rows of 2304).
+    conv: mtl.Buffer,
+    /// The last forward's last row of logits (FP32, softcapped).
+    logits: mtl.Buffer,
+
+    pub fn init(gpa: std.mem.Allocator, device: mtl.Device, capacity: usize) !Cache {
+        var out: Cache = .{ .memory = .{ .gpa = gpa, .device = device }, .capacity = capacity, .kv = undefined, .conv = undefined, .logits = undefined };
+        errdefer out.memory.deinit();
+        out.kv = try out.memory.alloc(bytesKv(capacity));
+        out.conv = try out.memory.alloc(g.visits * g.conv_floats * 4);
+        out.logits = try out.memory.alloc(g.vocab * 4);
+        out.reset();
+        return out;
+    }
+
+    /// An empty history: no positions, zero conv states.
+    pub fn reset(self: *Cache) void {
+        self.len = 0;
+        @memset(self.conv.contents()[0 .. g.visits * g.conv_floats * 4], 0);
+    }
+
+    pub fn keysOffset(self: *const Cache, slot: usize) usize {
+        return slot * 2 * self.capacity * row_kv_bytes;
+    }
+
+    pub fn valuesOffset(self: *const Cache, slot: usize) usize {
+        return self.keysOffset(slot) + self.capacity * row_kv_bytes;
+    }
+
+    pub fn convOffset(slot: usize) usize {
+        return slot * g.conv_floats * 4;
+    }
+
+    pub fn deinit(self: *Cache) void {
+        self.memory.deinit();
+    }
+};
+
+pub fn bytesKv(capacity: usize) usize {
+    return g.visits * 2 * capacity * row_kv_bytes;
+}
+
+/// Bytes a stream's cache takes at `capacity` positions.
+pub fn cacheBytes(capacity: usize) u64 {
+    return bytesKv(capacity) + g.visits * g.conv_floats * 4 + g.vocab * 4;
+}
+
+/// A forward's working rows, `rows` at most a call.
+pub const Scratch = struct {
+    memory: Storage,
+    rows: usize,
+    ids: mtl.Buffer,
+    /// The running hidden row (bf16), the four finished blocks (bf16, `rows` apart) and the message states (two).
+    x: mtl.Buffer,
+    blocks: mtl.Buffer,
+    states: mtl.Buffer,
+    /// Mix outputs [rows][up to 4][hidden] and messages [rows][4][hidden], FP32.
+    mix: mtl.Buffer,
+    msg: mtl.Buffer,
+    /// A gate's input [rows][2 hidden] bf16, its rank-64 row, its output [rows][hidden] FP32.
+    gate_in: mtl.Buffer,
+    gate_low: mtl.Buffer,
+    gate_out: mtl.Buffer,
+    /// Normed q, k and v inputs (bf16).
+    xq: mtl.Buffer,
+    xk: mtl.Buffer,
+    xv: mtl.Buffer,
+    q: mtl.Buffer,
+    k: mtl.Buffer,
+    v: mtl.Buffer,
+    r: mtl.Buffer,
+    gate: mtl.Buffer,
+    sink: mtl.Buffer,
+    dk: mtl.Buffer,
+    dv: mtl.Buffer,
+    kc: mtl.Buffer,
+    vc: mtl.Buffer,
+    qp: mtl.Buffer,
+    rp: mtl.Buffer,
+    attn: mtl.Buffer,
+    o: mtl.Buffer,
+    res: mtl.Buffer,
+    xm: mtl.Buffer,
+    route: mtl.Buffer,
+    picks: mtl.Buffer,
+    weights: mtl.Buffer,
+    act: mtl.Buffer,
+    ey: mtl.Buffer,
+    moe: mtl.Buffer,
+    logits: mtl.Buffer,
+    best: mtl.Buffer,
+    /// Logit rows a call can return (every row up to this many).
+    logit_rows: usize,
+
+    pub fn init(gpa: std.mem.Allocator, device: mtl.Device, rows: usize, logit_rows: usize) !Scratch {
+        var s: Scratch = undefined;
+        s.memory = .{ .gpa = gpa, .device = device };
+        errdefer s.memory.deinit();
+        s.rows = rows;
+        s.logit_rows = @max(1, @min(rows, logit_rows));
+        const m = &s.memory;
+        const d = g.hidden;
+        const qd = g.q_heads * g.head_dim;
+        const kv = g.kv_heads * g.head_dim;
+        const slots = rows * g.topk;
+        s.ids = try m.alloc(rows * 4);
+        s.x = try m.alloc(rows * d * 2);
+        s.blocks = try m.alloc(4 * rows * d * 2);
+        s.states = try m.alloc(2 * rows * d * 2);
+        s.mix = try m.alloc(rows * 4 * d * 4);
+        s.msg = try m.alloc(rows * 4 * d * 4);
+        s.gate_in = try m.alloc(rows * 2 * d * 2);
+        s.gate_low = try m.alloc(rows * g.rank * 2);
+        s.gate_out = try m.alloc(rows * d * 4);
+        inline for (.{ "xq", "xk", "xv", "o", "xm" }) |name| @field(s, name) = try m.alloc(rows * d * 2);
+        inline for (.{ "q", "gate", "qp", "attn" }) |name| @field(s, name) = try m.alloc(rows * qd * 2);
+        inline for (.{ "k", "v", "kc", "vc" }) |name| @field(s, name) = try m.alloc(rows * kv * 2);
+        s.r = try m.alloc(rows * g.q_heads * g.d_rel * 2);
+        s.rp = try m.alloc(rows * g.q_heads * g.d_rel * 2);
+        s.sink = try m.alloc(rows * g.q_heads * 2);
+        s.dk = try m.alloc(rows * g.kv_heads * 4 * 2);
+        s.dv = try m.alloc(rows * g.kv_heads * 4 * 2);
+        s.res = try m.alloc(rows * d * 4);
+        s.route = try m.alloc(rows * g.experts * 4);
+        s.picks = try m.alloc(slots * 4);
+        s.weights = try m.alloc(slots * 4);
+        s.act = try m.alloc(slots * g.inter * 4);
+        s.ey = try m.alloc(slots * d * 4);
+        s.moe = try m.alloc(rows * d * 4);
+        s.logits = try m.alloc(s.logit_rows * g.vocab * 4);
+        s.best = try m.alloc(s.logit_rows * 4);
+        return s;
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        self.memory.deinit();
+    }
+};
+
+test "a stream's cache: 48 slots of keys and values a position, conv states and one logit row" {
+    try std.testing.expectEqual(@as(u64, 48 * 2 * 2048), cacheBytes(1) - cacheBytes(0));
+    try std.testing.expectEqual(@as(usize, 20736), g.conv_floats);
+}
diff --git a/zig/src/families/inkling2/metal/weights.zig b/zig/src/families/inkling2/metal/weights.zig
new file mode 100644
index 0000000..68f96e0
--- /dev/null
+++ b/zig/src/families/inkling2/metal/weights.zig
@@ -0,0 +1,194 @@
+//! Views into the MLX affine checkpoint's buffers, every tensor's dtype and shape checked: no copies.
+const std = @import("std");
+const ck = @import("../../../core/checkpoint_metal.zig");
+const row = @import("../../../core/row_projection.zig");
+const mlx_affine = @import("../../../core/quant/mlx_affine.zig");
+const g = @import("geometry.zig");
+
+pub const Tensor = ck.Tensor;
+/// A bf16-table affine projection, as the core row kernels read it.
+pub const Linear = row.Weights;
+
+/// Routed experts [experts, n, k]: `bits`-wide codes, FP32 or (`bf16`) bf16 scales and biases as the checkpoint stores.
+pub const Experts = struct { w: Tensor, s: Tensor, b: Tensor, bits: u8, n: usize, k: usize, bf16: bool };
+
+/// A loop layer's message gate: down [rank, 2 * hidden], forget and gain [hidden, rank], all bf16.
+pub const Gate = struct { down: Tensor, forget: Tensor, gain: Tensor };
+
+/// A sliding layer's static k or v conv, or a global layer's static taps and their input-dependent projection.
+pub const KvConv = union(enum) { static: Tensor, dynamic: struct { taps: Tensor, proj: Tensor } };
+
+pub const Layer = struct {
+    global: bool,
+    boundary: bool,
+    /// The attention input's learned queries [nq, hidden] FP32 (none on layer 0), the MLP input's [hidden].
+    attn_query: ?Tensor,
+    mlp_query: Tensor,
+    /// q, k and v input norms (a sliding layer's one norm three times).
+    norms: [3]Tensor,
+    post_norm: Tensor,
+    q: Linear,
+    k: Linear,
+    v: Linear,
+    r: Linear,
+    o: Linear,
+    gate: Linear,
+    sink: Tensor,
+    q_scale: Tensor,
+    rel_scale: Tensor,
+    rel_proj: Tensor,
+    k_conv: KvConv,
+    v_conv: KvConv,
+    attn_conv: Tensor,
+    mlp_conv: Tensor,
+    router: Tensor,
+    router_bias: Tensor,
+    ex_gate: Experts,
+    ex_up: Experts,
+    ex_down: Experts,
+    /// q, k, v and MLP message gates on loop layers.
+    gates: ?[4]Gate,
+};
+
+pub const Weights = struct {
+    embed: Linear,
+    embed_norm: Tensor,
+    layers: [g.layers]Layer,
+    final_query: Tensor,
+    norm: Tensor,
+    head: Linear,
+    /// The loop layers' four message queries each [loop layers, 4, hidden] FP32.
+    message_query: Tensor,
+};
+
+const prefix = "language_model.model.";
+
+fn expect(c: *const ck.Checkpoint, name: []const u8, dtype: ck.DType, shape: []const usize) !Tensor {
+    const t = c.get(name) catch |e| {
+        std.log.err("{s}: missing from the Inkling 2 checkpoint", .{name});
+        return e;
+    };
+    if (t.dtype != dtype or t.rank != shape.len or !std.mem.eql(usize, t.shape[0..t.rank], shape) or t.offset % 4 != 0) {
+        std.log.err("{s}: unexpected Inkling 2 tensor dtype, shape or alignment", .{name});
+        return error.UnexpectedInklingTensor;
+    }
+    return t;
+}
+
+fn named(c: *const ck.Checkpoint, p: []const u8, suffix: []const u8, dtype: ck.DType, shape: []const usize) !Tensor {
+    var buf: [256]u8 = undefined;
+    return expect(c, try std.fmt.bufPrint(&buf, "{s}{s}", .{ p, suffix }), dtype, shape);
+}
+
+fn affine(c: *const ck.Checkpoint, p: []const u8, suffix: []const u8, n: usize, k: usize) !Linear {
+    var buf: [256]u8 = undefined;
+    const t = try mlx_affine.read(c, try std.fmt.bufPrint(&buf, "{s}{s}", .{ p, suffix }), .{ .n = n, .k = k, .group = g.group });
+    return row.affine(t);
+}
+
+/// Experts' codes at the width their word count carries (3 or 4 bits), with FP32 or bf16 tables of one group a 64.
+fn experts(c: *const ck.Checkpoint, p: []const u8, suffix: []const u8, n: usize, k: usize) !Experts {
+    var buf: [256]u8 = undefined;
+    const w = try c.get(try std.fmt.bufPrint(&buf, "{s}{s}.weight", .{ p, suffix }));
+    if (w.rank != 3 or w.dtype != .u32) return error.UnexpectedInklingTensor;
+    const bits: u8 = @intCast(w.shape[2] * 32 / k);
+    if (bits != 3 and bits != 4 or w.shape[2] * 32 != k * bits) return error.UnexpectedInklingTensor;
+    _ = try named(c, p, try std.fmt.bufPrint(&buf, "{s}.weight", .{suffix}), .u32, &.{ g.experts, n, k * bits / 32 });
+    const scales = try c.get(try std.fmt.bufPrint(&buf, "{s}{s}.scales", .{ p, suffix }));
+    const dtype: ck.DType = if (scales.dtype == .bf16) .bf16 else .f32;
+    return .{
+        .w = w,
+        .s = try named(c, p, try std.fmt.bufPrint(&buf, "{s}.scales", .{suffix}), dtype, &.{ g.experts, n, k / g.group }),
+        .b = try named(c, p, try std.fmt.bufPrint(&buf, "{s}.biases", .{suffix}), dtype, &.{ g.experts, n, k / g.group }),
+        .bits = bits,
+        .n = n,
+        .k = k,
+        .bf16 = dtype == .bf16,
+    };
+}
+
+fn gates(c: *const ck.Checkpoint, p: []const u8) ![4]Gate {
+    var out: [4]Gate = undefined;
+    for (&out, [_][]const u8{ "q", "k", "v", "mlp" }) |*gt, name| {
+        var buf: [96]u8 = undefined;
+        gt.down = try named(c, p, try std.fmt.bufPrint(&buf, "{s}_message_gate.down_proj.weight", .{name}), .bf16, &.{ g.rank, 2 * g.hidden });
+        gt.forget = try named(c, p, try std.fmt.bufPrint(&buf, "{s}_message_gate.forget_gate_proj.weight", .{name}), .bf16, &.{ g.hidden, g.rank });
+        gt.gain = try named(c, p, try std.fmt.bufPrint(&buf, "{s}_message_gate.message_gate_proj.weight", .{name}), .bf16, &.{ g.hidden, g.rank });
+    }
+    return out;
+}
+
+fn kvConv(c: *const ck.Checkpoint, p: []const u8, which: []const u8, global: bool) !KvConv {
+    var buf: [96]u8 = undefined;
+    const kv = g.kv_heads * g.head_dim;
+    if (!global) return .{ .static = try named(c, p, try std.fmt.bufPrint(&buf, "self_attn.{s}_sconv.conv.weight", .{which}), .bf16, &.{ kv, 4, 1 }) };
+    return .{ .dynamic = .{
+        .taps = try named(c, p, try std.fmt.bufPrint(&buf, "self_attn.{s}_sconv.static_weight", .{which}), .bf16, &.{ 4, kv }),
+        .proj = try named(c, p, try std.fmt.bufPrint(&buf, "self_attn.{s}_sconv.weight_proj.weight", .{which}), .bf16, &.{ g.kv_heads * 4, g.hidden }),
+    } };
+}
+
+fn layer(c: *const ck.Checkpoint, i: usize) !Layer {
+    var buf: [96]u8 = undefined;
+    const p = try std.fmt.bufPrint(&buf, "{s}layers.{d}.", .{ prefix, i });
+    const global = (i + 1) % 6 == 0;
+    const looped = i >= 6 and i < 18;
+    const d = g.hidden;
+    const qd = g.q_heads * g.head_dim;
+    const kv = g.kv_heads * g.head_dim;
+    var norms: [3]Tensor = undefined;
+    if (global) {
+        for (&norms, [_][]const u8{ "q", "k", "v" }) |*n, name| {
+            var nb: [64]u8 = undefined;
+            n.* = try named(c, p, try std.fmt.bufPrint(&nb, "{s}_input_layernorm.weight", .{name}), .bf16, &.{d});
+        }
+    } else norms = @splat(try named(c, p, "input_layernorm.weight", .bf16, &.{d}));
+    return .{
+        .global = global,
+        .boundary = i % g.block == 0,
+        .attn_query = if (i == 0) null else if (global) try named(c, p, "attention_input.query", .f32, &.{ 3, d }) else try named(c, p, "attention_input.query", .f32, &.{d}),
+        .mlp_query = try named(c, p, "mlp_input.query", .f32, &.{d}),
+        .norms = norms,
+        .post_norm = try named(c, p, "post_attention_layernorm.weight", .bf16, &.{d}),
+        .q = try affine(c, p, "self_attn.q_proj", qd, d),
+        .k = try affine(c, p, "self_attn.k_proj", kv, d),
+        .v = try affine(c, p, "self_attn.v_proj", kv, d),
+        .r = try affine(c, p, "self_attn.r_proj", g.q_heads * g.d_rel, d),
+        .o = try affine(c, p, "self_attn.o_proj", d, qd),
+        .gate = try affine(c, p, "self_attn.gate_proj", qd, d),
+        .sink = try named(c, p, "self_attn.sink_proj.weight", .bf16, &.{ g.q_heads, d }),
+        .q_scale = try named(c, p, "self_attn.q_scale", .bf16, &.{ g.q_heads, g.head_dim }),
+        .rel_scale = try named(c, p, "self_attn.rel_scale", .bf16, &.{ g.q_heads, g.d_rel }),
+        .rel_proj = try named(c, p, "self_attn.rel_proj", .bf16, &.{ g.d_rel, g.extent }),
+        .k_conv = try kvConv(c, p, "k", global),
+        .v_conv = try kvConv(c, p, "v", global),
+        .attn_conv = try named(c, p, "attn_sconv.conv.weight", .bf16, &.{ d, 4, 1 }),
+        .mlp_conv = try named(c, p, "mlp_sconv.conv.weight", .bf16, &.{ d, 4, 1 }),
+        .router = try named(c, p, "mlp.gate_weight", .bf16, &.{ g.experts, d }),
+        .router_bias = try named(c, p, "mlp.e_score_correction_bias", .f32, &.{g.experts}),
+        .ex_gate = try experts(c, p, "mlp.switch_mlp.gate_proj", g.inter, d),
+        .ex_up = try experts(c, p, "mlp.switch_mlp.up_proj", g.inter, d),
+        .ex_down = try experts(c, p, "mlp.switch_mlp.down_proj", d, g.inter),
+        .gates = if (looped) try gates(c, p) else null,
+    };
+}
+
+pub fn load(c: *const ck.Checkpoint) !Weights {
+    var w: Weights = .{
+        .embed = try affine(c, prefix, "embed_tokens", g.vocab, g.hidden),
+        .embed_norm = try named(c, prefix, "embed_norm.weight", .bf16, &.{g.hidden}),
+        .layers = undefined,
+        .final_query = try named(c, prefix, "final_input.query", .f32, &.{g.hidden}),
+        .norm = try named(c, prefix, "norm.weight", .bf16, &.{g.hidden}),
+        .head = try affine(c, "language_model.", "lm_head", g.vocab, g.hidden),
+        .message_query = try named(c, prefix, "message_input.query", .f32, &.{ 12, 4, g.hidden }),
+    };
+    if (w.embed.bits != 4) return error.UnexpectedInklingTensor;
+    if (w.head.bits != 4 and w.head.bits != 6 and w.head.bits != 8) return error.UnexpectedInklingTensor;
+    for (&w.layers, 0..) |*l, i| {
+        l.* = try layer(c, i);
+        const same = l.ex_gate.bits == l.ex_up.bits and l.ex_gate.bf16 == l.ex_up.bf16 and l.ex_gate.bf16 == l.ex_down.bf16;
+        if (!same) return error.UnexpectedInklingTensor;
+    }
+    return w;
+}
