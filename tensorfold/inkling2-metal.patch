diff --git a/zig/tests/inkling2/run.zig b/zig/tests/inkling2/run.zig
new file mode 100644
index 0000000..85afe2a
--- /dev/null
+++ b/zig/tests/inkling2/run.zig
@@ -0,0 +1,180 @@
+//! tf-inkling2-run MODEL_DIR REF_DIR [decode_tokens] [prompt_rows]: Mini on Metal against a reference dir, then timing.
+const std = @import("std");
+const mtl = @import("metal");
+const tf = @import("tensorfold");
+const ink = tf.inkling2_metal;
+const g = ink.geometry;
+
+fn readJsonIds(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]u32 {
+    var buf: [1024]u8 = undefined;
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, try std.fmt.bufPrint(&buf, "{s}/{s}", .{ dir, name }), gpa, .limited(1 << 20));
+    defer gpa.free(bytes);
+    const parsed = try std.json.parseFromSlice([]u32, gpa, bytes, .{});
+    defer parsed.deinit();
+    return gpa.dupe(u32, parsed.value);
+}
+
+fn readNpy(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, name: []const u8) ![]f32 {
+    var buf: [1024]u8 = undefined;
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, try std.fmt.bufPrint(&buf, "{s}/{s}", .{ dir, name }), gpa, .limited(1 << 30));
+    defer gpa.free(bytes);
+    const a = try tf.npy.parse(bytes);
+    if (!std.mem.eql(u8, a.descr, "<f4")) return error.ExpectedF32Npy;
+    const out = try gpa.alloc(f32, a.count());
+    @memcpy(std.mem.sliceAsBytes(out), a.data[0 .. out.len * 4]);
+    return out;
+}
+
+fn bf16(v: u16) f32 {
+    return @bitCast(@as(u32, v) << 16);
+}
+
+/// The worst row's cosine between native bf16 rows and the reference's FP32 rows, and the mean.
+fn cosine(native: []const u16, ref: []const f32, rows: usize) [2]f64 {
+    var worst: f64 = 1;
+    var sum: f64 = 0;
+    for (0..rows) |r| {
+        var dot: f64 = 0;
+        var na: f64 = 0;
+        var nb: f64 = 0;
+        for (0..g.hidden) |i| {
+            const a: f64 = bf16(native[r * g.hidden + i]);
+            const b: f64 = ref[r * g.hidden + i];
+            dot += a * b;
+            na += a * a;
+            nb += b * b;
+        }
+        const c = dot / (@sqrt(na * nb) + 1e-30);
+        worst = @min(worst, c);
+        sum += c;
+    }
+    return .{ worst, sum / @as(f64, @floatFromInt(rows)) };
+}
+
+fn now() f64 {
+    var t: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(std.c.CLOCK.MONOTONIC, &t);
+    return @as(f64, @floatFromInt(t.sec)) + @as(f64, @floatFromInt(t.nsec)) / 1e9;
+}
+
+pub fn main(init: std.process.Init) !void {
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 3) return error.ExpectedModelAndReferenceDirs;
+    const decode_n: usize = if (args.len > 3) try std.fmt.parseInt(usize, args[3], 10) else 16;
+    const chunk: usize = if (args.len > 4) try std.fmt.parseInt(usize, args[4], 10) else 0;
+    const pool = mtl.objc.Pool.push();
+    defer pool.pop();
+    const ids = try readJsonIds(gpa, io, args[2], "tokens.json");
+    defer gpa.free(ids);
+    const want = readJsonIds(gpa, io, args[2], "greedy.json") catch try gpa.alloc(u32, 0);
+    defer gpa.free(want);
+    const t_load = now();
+    const m = try ink.Model.load(gpa, io, args[1]);
+    defer m.deinit();
+    std.debug.print("loaded in {d:.1} s\n", .{now() - t_load});
+    const rows = ids.len;
+    if (std.c.getenv("TF_INK_DUMP")) |dir| return dump(gpa, io, m, ids, std.mem.span(dir));
+    var cache = try ink.state.Cache.init(gpa, m.device, rows + decode_n + 8);
+    defer cache.deinit();
+    var scratch = try ink.state.Scratch.init(gpa, m.device, @max(rows, 1), rows);
+    defer scratch.deinit();
+    const cap = try cache.memory.alloc((g.visits + 1) * rows * g.hidden * 2);
+    try ink.forward.run(m, &scratch, &cache, ids, .{ .head = .all, .capture = cap });
+    const native = cap.slice(u16, (g.visits + 1) * rows * g.hidden);
+    var worst: f64 = 1;
+    for (0..g.visits + 1) |v| {
+        var nb: [64]u8 = undefined;
+        const name = if (v < g.visits) try std.fmt.bufPrint(&nb, "hidden_step{d}.npy", .{v}) else "final_norm.npy";
+        const ref = readNpy(gpa, io, args[2], name) catch |e| {
+            std.debug.print("{s}: {s}\n", .{ name, @errorName(e) });
+            continue;
+        };
+        defer gpa.free(ref);
+        const c = cosine(native[v * rows * g.hidden ..][0 .. rows * g.hidden], ref, rows);
+        worst = @min(worst, c[0]);
+        const plan = if (v < g.visits) m.plan[v] else ink.loop.Visit{ .layer = 99, .pass = 0, .slot = 0 };
+        std.debug.print("{s:>18} layer {d:>2} pass {d}: worst row cos {d:.6}, mean {d:.6}\n", .{ name, plan.layer, plan.pass, c[0], c[1] });
+    }
+    std.debug.print("worst hidden cosine over every visit and row: {d:.6}\n", .{worst});
+    if (readNpy(gpa, io, args[2], "last_logits.npy")) |ref| {
+        defer gpa.free(ref);
+        const last = scratch.logits.slice(f32, rows * g.vocab)[(rows - 1) * g.vocab ..][0..ref.len];
+        var dot: f64 = 0;
+        var na: f64 = 0;
+        var nb2: f64 = 0;
+        var diff: f64 = 0;
+        var ref_best: usize = 0;
+        for (ref, last, 0..) |b, a, i| {
+            dot += @as(f64, a) * b;
+            na += @as(f64, a) * a;
+            nb2 += @as(f64, b) * b;
+            diff = @max(diff, @abs(@as(f64, a) - b));
+            if (b > ref[ref_best]) ref_best = i;
+        }
+        std.debug.print("last logits: cos {d:.6}, max abs diff {d:.4}, ref top {d}, native top {d}\n", .{ dot / @sqrt(na * nb2), diff, ref_best, scratch.best.slice(u32, rows)[rows - 1] });
+    } else |_| {}
+    // Greedy decode from the prompt's last pick, then timing.
+    var out: std.ArrayList(u32) = .empty;
+    defer out.deinit(gpa);
+    var next = scratch.best.slice(u32, rows)[rows - 1];
+    try out.append(gpa, next);
+    var one = try ink.state.Scratch.init(gpa, m.device, 1, 1);
+    defer one.deinit();
+    const t0 = now();
+    for (1..decode_n) |_| {
+        try ink.forward.run(m, &one, &cache, &.{next}, .{ .head = .all });
+        next = one.best.slice(u32, 1)[0];
+        try out.append(gpa, next);
+    }
+    const dt = now() - t0;
+    std.debug.print("greedy: {any}\n", .{out.items});
+    if (want.len > 0) {
+        var same: usize = 0;
+        while (same < @min(want.len, out.items.len) and want[same] == out.items[same]) same += 1;
+        std.debug.print("greedy matches the reference for {d} of {d} tokens\n", .{ same, want.len });
+    }
+    if (decode_n > 1) std.debug.print("decode: {d} tokens in {d:.3} s = {d:.2} tok/s\n", .{ decode_n - 1, dt, @as(f64, @floatFromInt(decode_n - 1)) / dt });
+    if (chunk > 0) try prefill(gpa, m, chunk);
+}
+
+/// Prompt timing: one cold chunk of `n` synthetic ids, best of three, with no head past the last row.
+fn prefill(gpa: std.mem.Allocator, m: *ink.Model, n: usize) !void {
+    var cache = try ink.state.Cache.init(gpa, m.device, n);
+    defer cache.deinit();
+    var scratch = try ink.state.Scratch.init(gpa, m.device, n, 1);
+    defer scratch.deinit();
+    const ids = try gpa.alloc(u32, n);
+    defer gpa.free(ids);
+    for (ids, 0..) |*id, i| id.* = @intCast((i * 7919 + 13) % 200000);
+    var best: f64 = 1e30;
+    for (0..3) |_| {
+        cache.reset();
+        const t0 = now();
+        try ink.forward.run(m, &scratch, &cache, ids, .{ .head = .last });
+        best = @min(best, now() - t0);
+    }
+    std.debug.print("prefill: {d} tokens in {d:.3} s = {d:.1} tok/s\n", .{ n, best, @as(f64, @floatFromInt(n)) / best });
+}
+
+/// Debugging: the first TF_INK_VISITS visits (default 1), then every scratch buffer's rows written raw into `dir`.
+fn dump(gpa: std.mem.Allocator, io: std.Io, m: *ink.Model, ids: []const u32, dir: []const u8) !void {
+    const visits: usize = if (std.c.getenv("TF_INK_VISITS")) |v| try std.fmt.parseInt(usize, std.mem.span(v), 10) else 1;
+    var cache = try ink.state.Cache.init(gpa, m.device, ids.len + 8);
+    defer cache.deinit();
+    var s = try ink.state.Scratch.init(gpa, m.device, ids.len, ids.len);
+    defer s.deinit();
+    try ink.forward.run(m, &s, &cache, ids, .{ .head = .none, .visits = visits });
+    const names = [_][]const u8{ "x", "xq", "xk", "xv", "q", "k", "v", "r", "gate", "sink", "dk", "dv", "kc", "vc", "qp", "rp", "attn", "o", "res", "mix", "msg", "xm", "route", "picks", "weights", "act", "ey", "moe", "blocks", "states", "gate_out" };
+    inline for (names) |n| {
+        const b = @field(s, n);
+        var nb: [512]u8 = undefined;
+        try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fmt.bufPrint(&nb, "{s}/{s}.bin", .{ dir, n }), .data = b.contents()[0..b.length()] });
+    }
+    var nb: [512]u8 = undefined;
+    const kv = ink.state.row_kv_bytes * ids.len;
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fmt.bufPrint(&nb, "{s}/keys0.bin", .{dir}), .data = cache.kv.contents()[cache.keysOffset(0)..][0..kv] });
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fmt.bufPrint(&nb, "{s}/values0.bin", .{dir}), .data = cache.kv.contents()[cache.valuesOffset(0)..][0..kv] });
+    std.debug.print("dumped {d} visit(s) into {s}\n", .{ visits, dir });
+}
